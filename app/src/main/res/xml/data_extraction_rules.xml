<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Recordings are large and device-specific; only the settings are transferred. -->
    <cloud-backup>
        <include domain="sharedpref" path="spotad_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="spotad_settings.xml" />
    </device-transfer>
</data-extraction-rules>
